# Arguments for boris_trace_scatter_slider.py.
# Run from the repo root with:
#   QT_QPA_PLATFORM=wayland conda run -n testenv python fastplotlib_tests/boris_trace_scatter_slider.py @fastplotlib_tests/scatter_slider_speed_custom.args

--trace-file output/It-0486_Ih-0900_noErr_1500sp_LSODA1e8/data/Ion_traces_0mm_LCFS40_2eV_60V_Z1_Lithium_TRACK360x180_IdealIota3_collisionTest_both_TypicalOperation_stride13.npy

--color-mode energy
--sample-dt 1.3e-7
--ion-mass-amu 6.941
--cmap my_registered_cmap
--color-vmin 0
--color-vmax 30
--max-particles 30000
--marker-size 4
--frame-stride 2
--size 1920x1400
--torus-style wireframe
--torus-color '#ffffff'
--torus-wire-alpha 0.3
--torus-half full
--histogram-bins 200
--histogram-color-vmin 0
--histogram-color-vmax 30
--histogram-height 330
--histogram-log-y
--side-panel-width 853
--export-mp4 output/LCFS40_2eV_60V_Z1_Lithium_TRACK360x180_IdealIota3_collisionTest_both_TypicalOperation_stride13_NEW.mp4
--export-start 0
--export-stop 5000
--export-step 1
--export-fps 60
--export-size 2560x1440